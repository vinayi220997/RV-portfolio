# Copy this file to .env and fill in real values. NEVER commit .env.

# SQLite database path (single file, treated as private storage)
DATABASE_URL="file:./dev.db"

# Strong random 32-byte hex — generate with: openssl rand -hex 32
SESSION_SECRET=""

# Bootstrap admin credentials — change immediately after first login
BOOTSTRAP_LOGIN_ID="admin_user"
BOOTSTRAP_PASSWORD="admin_password@58"

# AES-GCM key for encrypting private files at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Gmail OAuth (leave blank until configured — see README > Gmail Setup)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""
GMAIL_FROM_ADDRESS=""

# Public site URL (used for SEO metadata + sitemap)
PUBLIC_SITE_URL=""
